Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "ERme", ",", "ERps", ",", "\[Alpha]", ",", "\[Psi]1", ",", "\[Psi]2", ",", 
    "\[Sigma]x", ",", "Ud", ",", "maxEE"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]x", "=", 
    RowBox[{"PauliMatrix", "[", "1", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Ud", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Cos", "[", "\[Alpha]", "]"}], " ", 
    RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "-", " ", 
   RowBox[{"I", " ", 
    RowBox[{"Sin", "[", "\[Alpha]", "]"}], " ", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"\[Sigma]x", ",", "\[Sigma]x"}], 
     "]"}]}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]", "=", 
   RowBox[{"Ud", ".", 
    RowBox[{"{", 
     RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}]}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "this", " ", "expression", " ", "looks", " ", "similar", " ", "to", " ", 
    RowBox[{"sin", "^", "2"}], " ", "but", " ", "is", " ", "less", " ", 
    "symmetric"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxEE", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Alpha]", "]"}], "^", "2"}]}], " ", 
     RowBox[{"Log2", "[", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Alpha]", "]"}], "^", "2"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", "\[Alpha]", "]"}], "^", "2"}], " ", 
     RowBox[{"Log2", "[", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Alpha]", "]"}], "^", "2"}], "]"}]}]}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"maxEE", ",", 
     RowBox[{
      RowBox[{"Sin", "[", 
       RowBox[{"2", "\[Alpha]"}], "]"}], "^", "2"}], ",", "0.5", ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Tanh", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"\[Alpha]", "-", 
            RowBox[{"\[Pi]", "/", "8"}]}], ")"}], "10000"}], "]"}], "+", 
        "1"}], ")"}], "/", "2"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Alpha]", ",", "0", ",", 
     RowBox[{"\[Pi]", "/", "4"}]}], "}"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Alpha]\>\"", ",", "\"\<EE\>\""}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.991126861006514*^9, 3.991127135500092*^9}, {
  3.991127174326454*^9, 3.99112717985286*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"26b72a9d-8bb6-4d1d-a5df-483c73a8e257"],

